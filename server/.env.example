# AI 配置（OpenAI Chat Completions 兼容格式）
AI_API_KEY=your-api-key-here
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-chat

# 管理后台密码
ADMIN_PASSWORD=your-admin-password

# GitHub Token（可选）：提高 GitHub API 限流配额（60 → 5000 次/小时）
# 可通过 `gh auth token` 获取
GITHUB_TOKEN=

# 数据库路径（默认 server/zhuanglema.db）
DB_PATH=zhuanglema.db
